{
    "private": true,
    "type": "module",
    "scripts": {
        "format-app": "npx prettier --write src/",
        "format-examples": "npx prettier --write examples/",
        "format-tests": "npx prettier --write tests/"
    },
    "dependencies": {
        "autoprefixer": "^10.4.21"
    },
    "devDependencies": {
        "@prettier/plugin-php": "^0.22.4",
        "husky": "^8.0.0",
        "lint-staged": "^15.4.3",
        "prettier": "^3.5.3",
        "prettier-plugin-blade": "^2.1.21",
        "prettier-plugin-tailwindcss": "^0.6.11"
    },
    "lint-staged": {
        "**/*.php*": [
            "vendor/bin/duster fix",
            "npm run format-app",
            "npm run format-examples",
            "npm run format-tests"
        ]
    }
}
