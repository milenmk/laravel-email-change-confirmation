{
    "name": "milenmk/laravel-email-change-confirmation",
    "description": "A Laravel package for secure email change confirmation with support for both traditional controllers and Livewire components",
    "license": "MIT",
    "keywords": [
        "laravel",
        "email",
        "change",
        "confirmation",
        "security",
        "verification",
        "livewire"
    ],
    "authors": [
        {
            "name": "Milen Karaganski",
            "email": "milenmk@gmail.com"
        }
    ],
    "repository": [
        {
            "type": "git",
            "url": "https://github.com/milenmk/laravel-email-change-confirmation.git"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/notifications": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/validation": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.4.4",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpstan/phpstan": "^1.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "squizlabs/php_codesniffer": "^3.13",
        "tightenco/duster": "^3.2"
    },
    "suggest": {
        "livewire/livewire": "Required for Livewire component support (^3.0)"
    },
    "autoload": {
        "psr-4": {
            "MilenMk\\LaravelEmailChangeConfirmation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MilenMk\\LaravelEmailChangeConfirmation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MilenMk\\LaravelEmailChangeConfirmation\\EmailChangeConfirmationServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "conflict": {
        "laravel/framework": "<10.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
